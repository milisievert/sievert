{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": [],
    "rootDir": "src",
    "module": "esnext",
    "moduleResolution": "bundler",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "ignoreDeprecations": "6.0"
  },
  "exclude": [
    "out-tsc",
    "dist",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../../libs/di/tsconfig.lib.json"
    },
    {
      "path": "../../libs/router/tsconfig.lib.json"
    },
    {
      "path": "../../libs/signals/tsconfig.lib.json"
    },
    {
      "path": "../../libs/renderer/tsconfig.lib.json"
    },
    {
      "path": "../../libs/component/tsconfig.lib.json"
    }
  ]
}
