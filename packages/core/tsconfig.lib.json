{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../../libs/signals/tsconfig.lib.json"
    },
    {
      "path": "../../libs/renderer/tsconfig.lib.json"
    },
    {
      "path": "../../libs/directive/tsconfig.lib.json"
    },
    {
      "path": "../../libs/di/tsconfig.lib.json"
    },
    {
      "path": "../../libs/component/tsconfig.lib.json"
    }
  ]
}
